{
  "name": "Daily Planner",
  "short_name": "Planner",
  "description": "Plan your day, calendar, reminders, habits and yearly timeline.",
  "start_url": "./index.html#/today",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f4f5fa",
  "theme_color": "#4f46e5",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My Day", "url": "./index.html#/today" },
    { "name": "Calendar", "url": "./index.html#/calendar" },
    { "name": "Year Timeline", "url": "./index.html#/timeline" }
  ]
}
